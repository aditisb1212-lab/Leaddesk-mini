# Leave unset for local dev - Vite's dev server proxies /api to the
# backend on localhost:5000 (see vite.config.js).
#
# For a production build, set this to your deployed backend's full URL,
# including the /api prefix:
# VITE_API_BASE_URL=https://leaddesk-mini-api.onrender.com/api
VITE_API_BASE_URL= https://leaddesk-mini-5.onrender.com

