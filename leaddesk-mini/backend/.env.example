# SQLite database file path. Relative paths are resolved from backend/.
# Default (if unset) is backend/leaddesk.sqlite3 - fine for local dev and
# for small free-tier deployments with a persistent disk (e.g. Render).
DB_FILE=./leaddesk.sqlite3

# Server
PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET=hAh3DCkKyLra5vqI7FsrwqOcZUGky2xuevbMUADUDjMGqmTyI5e9EQkSregtIPcyXrYgPJtoz6Uj4lXFvWR0XORIp3XvB089IMBl
JWT_EXPIRES_IN=8h

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Used only by utils/seedAdmin.js to create/rotate the admin account.
# Run `npm run seed:admin` once, then remove/rotate these.
SEED_ADMIN_EMAIL=admin@leaddesk.test
SEED_ADMIN_PASSWORD=DigiHeroes
